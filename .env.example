# 把本文件复制成 .env（同目录），填好值即可。
#
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# ⚠️ .env 里有 API Key，已被 .gitignore 忽略，**不要提交、不要发群里**。
# ⚠️ 这里的 KEY 只是占位符，不要在这里填真实值（示例文件也不该含真密钥）。
#
# ── 变量名为什么带 _NAME ──────────────────────────────
# swanlab 0.10.x 内部用 pydantic-settings，配置模型里：
#     project:    ProjectSettings   （子字段 name / workspace / public）
#     experiment: ExperimentSettings（子字段 name / color / description ...）
# 且 model_config 设了 env_nested_delimiter="_"。
# 因此 `SWANLAB_PROJECT=xxx` 会被当成"给嵌套模型传 JSON"→ SettingsError。
# 正确写法是本文件里的 SWANLAB_PROJECT_NAME / SWANLAB_EXPERIMENT_NAME。
#
# SWANLAB_MODE 只接受：disabled / online / local / offline
#   （不是 cloud；早期文档里写的 cloud 是错的）
#
# 值统一用双引号包裹，避免第三方解析歧义。

# ---------- SwanLab 实验记录（仅本地/联网时需要）----------
SWANLAB_ENABLED="true"
SWANLAB_PROJECT_NAME="zhixun-engine"
SWANLAB_EXPERIMENT_NAME="gas-validation"
# 从 https://swanlab.cn/ → 头像 → 设置 → API Key 复制后粘贴到引号内（仅填在 .env 里）
SWANLAB_API_KEY=""
SWANLAB_MODE="online"

# ---------- 决策层（只有接大模型时才需要）----------
# 不接 LLM 时全部注释掉，用 --llm none 跑
# QWEN_BASE_URL="https://pytrio.com/api/openai/v1"
# QWEN_API_KEY=""
# QWEN_4B_MODEL="Qwen/Qwen3.5-4B"
